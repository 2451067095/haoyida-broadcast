<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Haoyida</AssemblyName>
    <RootNamespace>Haoyida</RootNamespace>
    <Product>耗易达-超市播音软件</Product>
    <AssemblyTitle>耗易达-超市播音软件</AssemblyTitle>
    <Company>深圳市耗易达供应链管理有限公司</Company>
    <Copyright>Copyright © 2026 耗易达</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>Haoyida.Program</StartupObject>
  </PropertyGroup>

  <!-- 本项目刻意不引用任何第三方 NuGet 包：整机 TLS 栈异常时仍可离线构建。 -->
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Resource Include="Assets\wechat-qr.jpg" />
    <Resource Include="Assets\app.ico" />
    <Content Include="Assets\tts\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\music\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
