<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      设计依据：GitHub awesome-design-skills / dashboard 的 DESIGN.md
      primary #0C5CAB · success #10b981 · warning #f59e0b · danger #ef4444
      surface #09090b · text #fafafa · 8pt 栅格 · 圆角 sm=4 / md=8
      深色底上 #0C5CAB 作为正文色对比度不足，故派生 Accent(#3B9EFF) 专用于文字与图标，
      按钮底色仍使用规范 primary。这是一处有据可查的可访问性妥协。
    -->

    <Color x:Key="Surface0Color">#09090B</Color>
    <Color x:Key="Surface1Color">#0D0D11</Color>
    <Color x:Key="Surface2Color">#121216</Color>
    <Color x:Key="Surface3Color">#17171D</Color>
    <Color x:Key="PrimaryColor">#0C5CAB</Color>
    <Color x:Key="PrimaryHoverColor">#1468BF</Color>
    <Color x:Key="AccentColor">#3B9EFF</Color>
    <Color x:Key="OkColor">#10B981</Color>
    <Color x:Key="WarnColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="TextColor">#FAFAFA</Color>
    <Color x:Key="TextDimColor">#A1A1AA</Color>
    <Color x:Key="TextFaintColor">#7A7A85</Color>
    <Color x:Key="StrokeColor">#26262E</Color>
    <Color x:Key="StrokeSoftColor">#1C1C22</Color>

    <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0Color}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeSoftBrush" Color="{StaticResource StrokeSoftColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A3B9EFF" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="#1A10B981" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#1AF59E0B" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1AEF4444" />

    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#191920" Offset="0" />
        <GradientStop Color="#111116" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RailGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0C0C10" Offset="0" />
        <GradientStop Color="#09090B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#12233A" Offset="0" />
        <GradientStop Color="#10151F" Offset="0.55" />
        <GradientStop Color="#111116" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#003B9EFF" Offset="0" />
        <GradientStop Color="#FF3B9EFF" Offset="0.35" />
        <GradientStop Color="#003B9EFF" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000" />

    <FontFamily x:Key="UiFont">IBM Plex Sans, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="MonoFont">IBM Plex Mono, Consolas, Microsoft YaHei UI</FontFamily>


    <!-- ===== 文本层级 ===== -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="H1Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="H2Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="H3Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>

    <Style x:Key="StrongText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
    </Style>

    <Style x:Key="LabelCaps" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>

    <!-- ===== 卡片：玻璃质感 = 渐变底 + 1px 描边 + 顶部高光 ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CardFlat" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
    </Style>

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource StrokeSoftBrush}" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

</ResourceDictionary>
