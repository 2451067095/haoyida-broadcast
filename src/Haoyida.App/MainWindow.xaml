<Window x:Class="Haoyida.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Haoyida.ViewModels"
        xmlns:views="clr-namespace:Haoyida.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="Assets/app.ico" Title="耗易达-超市播音软件" Width="1440" Height="900" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource Surface0Brush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <vm:BoolToVisibility x:Key="BoolToVis" />
        <vm:NotEmptyToVisibility x:Key="NotEmpty" />
        <vm:IndexMatchToVisibility x:Key="PageVis" />
        <vm:KeyToBrush x:Key="KeyBrush" />
        <vm:PercentConverter x:Key="Percent" />
    </Window.Resources>

    <Border x:Name="RootLayout" Background="{StaticResource Surface0Brush}" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Grid Grid.Row="0" Background="#0A0A0D" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <views:LogoMark Width="26" Height="26" />
                    <TextBlock Text="耗易达 · 超市播音" Margin="9,0,0,0" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinBtn" Style="{StaticResource IconBtn}" Click="Min_Click" Width="44" Height="44" ToolTip="最小化">
                        <Path Data="M0,0 H10" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource IconBtn}" Click="Max_Click" Width="44" Height="44" ToolTip="最大化">
                        <Path Data="M0,0 H9 V9 H0 Z" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource IconBtn}" Click="Close_Click" Width="44" Height="44" ToolTip="关闭">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.4" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ 主体 ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <Border Grid.Column="0" Background="{StaticResource RailGradient}" BorderBrush="{StaticResource StrokeSoftBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="16,18,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="4,0,4,18">
                            <TextBlock Text="{Binding Profile.StoreName}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Profile.Branch}" FontSize="11.5" Margin="0,3,0,0"
                                       Foreground="{StaticResource TextFaintBrush}" />
                        </StackPanel>

                        <ListBox Grid.Row="1" Style="{StaticResource PlainList}" SelectedIndex="{Binding PageIndex, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource NavItem}">
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M0,0 H6 V6 H0 Z M9,0 H15 V6 H9 Z M0,9 H6 V15 H0 Z M9,9 H15 V15 H9 Z"
                                          Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.3" Width="15" Height="15"
                                          Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="播报台" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M1,4 H15 V15 H1 Z M1,8 H15 M5,2 V5 M11,2 V5"
                                          Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.3" Width="15" Height="15"
                                          Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="播报计划" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M3,1 H11 L14,4 V15 H3 Z M11,1 V4 H14 M5,8 H12 M5,11 H12"
                                          Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.3" Width="15" Height="15"
                                          Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="文案库" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M1,1 H7 L14,8 L8,14 L1,7 Z M4.5,4.5 A0.8,0.8 0 1,0 4.6,4.5"
                                          Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.3" Width="15" Height="15"
                                          Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="促销商品" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M6,2 V13 M6,3 Q10,2 13,4 V11 Q10,9 6,10 M3,10 A2.5,2.5 0 1,0 8,10 A2.5,2.5 0 1,0 3,10"
                                          Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.3" Width="15" Height="15"
                                          Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="背景音乐" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M1,8 V8 M4,5 V11 M7,2 V14 M10,4 V12 M13,6 V10 M15,8 V8"
                                          Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5" Width="15" Height="15"
                                          Stretch="Uniform" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <TextBlock Grid.Column="1" Text="音色引擎" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M1,3 H14 M1,8 H14 M1,13 H10" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.4"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" StrokeStartLineCap="Round" />
                                    <TextBlock Grid.Column="1" Text="播报日志" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M7,1.5 A5.5,5.5 0 1,0 7,12.5 A5.5,5.5 0 1,0 7,1.5 M7,0 V2.5 M7,11.5 V14 M0,7 H2.5 M11.5,7 H14"
                                          Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.3" Width="15" Height="15"
                                          Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="系统设置" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                                </Grid>
                            </ListBoxItem>
                        </ListBox>

                        <!-- 值守状态卡 -->
                        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{Binding RunStateKey, Converter={StaticResource KeyBrush}}" />
                                        <TextBlock Text="{Binding RunStateText}" Margin="7,0,0,0" FontSize="12.5"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ClockText}" HorizontalAlignment="Right" FontSize="12"
                                               FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextFaintBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding LastBroadcastText}" Margin="0,8,0,0" FontSize="11.5"
                                           TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" />
                                <Button Content="切换值守" Command="{Binding StartStopCommand}" Style="{StaticResource GhostBtn}"
                                        Margin="0,10,0,0" Padding="0,6" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 右侧内容 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="28,22,28,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1Text}" />
                            <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource BodyText}" Margin="0,5,0,0" FontSize="12.5" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Chip}" Margin="0,0,8,0" Background="{StaticResource OkSoftBrush}"
                                    BorderBrush="#2A10B981">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="今日" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TodayCount}" Margin="5,0" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="条" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="{StaticResource AccentSoftBrush}" BorderBrush="#2A3B9EFF">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="队列" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding QueueCount}" Margin="5,0" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="条" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="28,0,28,24">
                        <views:DashboardView Visibility="{Binding PageIndex, Converter={StaticResource PageVis}, ConverterParameter=0}" />
                        <views:TasksView Visibility="{Binding PageIndex, Converter={StaticResource PageVis}, ConverterParameter=1}" />
                        <views:ScriptsView Visibility="{Binding PageIndex, Converter={StaticResource PageVis}, ConverterParameter=2}" />
                        <views:ProductsView Visibility="{Binding PageIndex, Converter={StaticResource PageVis}, ConverterParameter=3}" />
                        <views:MusicView Visibility="{Binding PageIndex, Converter={StaticResource PageVis}, ConverterParameter=4}" />
                        <views:VoicesView Visibility="{Binding PageIndex, Converter={StaticResource PageVis}, ConverterParameter=5}" />
                        <views:LogsView Visibility="{Binding PageIndex, Converter={StaticResource PageVis}, ConverterParameter=6}" />
                        <views:SettingsView Visibility="{Binding PageIndex, Converter={StaticResource PageVis}, ConverterParameter=7}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
