<UserControl x:Class="Haoyida.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Haoyida.ViewModels">
    <UserControl.Resources>
        <vm:KeyToBrush x:Key="KeyBrush" />
        <vm:ZeroToVisibility x:Key="ZeroVis" />
        <vm:NotEmptyToVisibility x:Key="NotEmpty" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="全部" Style="{StaticResource GhostBtn}" Padding="12,5" FontSize="11.5" Margin="0,0,6,0"
                        Command="{Binding SetLogFilterCommand}" CommandParameter="全部" />
                <Button Content="成功" Style="{StaticResource GhostBtn}" Padding="12,5" FontSize="11.5" Margin="0,0,6,0"
                        Command="{Binding SetLogFilterCommand}" CommandParameter="成功" />
                <Button Content="失败" Style="{StaticResource GhostBtn}" Padding="12,5" FontSize="11.5" Margin="0,0,6,0"
                        Command="{Binding SetLogFilterCommand}" CommandParameter="失败" />
                <Button Content="试听" Style="{StaticResource GhostBtn}" Padding="12,5" FontSize="11.5"
                        Command="{Binding SetLogFilterCommand}" CommandParameter="试听" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="导出 CSV" Style="{StaticResource SecondaryBtn}" Padding="12,6" FontSize="11.5"
                        Command="{Binding ExportLogsCommand}" />
                <Button Content="清空日志" Style="{StaticResource DangerBtn}" Padding="12,6" FontSize="11.5" Margin="8,0,0,0"
                        Command="{Binding ClearLogsCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="22,16,22,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="86" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="时间" Style="{StaticResource LabelCaps}" />
                    <TextBlock Grid.Column="1" Text="播报内容" Style="{StaticResource LabelCaps}" />
                    <TextBlock Grid.Column="2" Text="引擎 / 音色" Style="{StaticResource LabelCaps}" />
                    <TextBlock Grid.Column="3" Text="耗时" Style="{StaticResource LabelCaps}" />
                </Grid>

                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding LogView}" Margin="12,0,12,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" CornerRadius="8" Padding="10,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                   Foreground="{StaticResource TextDimBrush}" />
                                        <TextBlock Text="{Binding Status}" FontSize="10.5" Margin="0,3,0,0"
                                                   Foreground="{Binding StatusKey, Converter={StaticResource KeyBrush}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Text}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Error}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Engine, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Voice, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Engine.Logs.Count, Converter={StaticResource ZeroVis}}">
                    <TextBlock Text="还没有播报记录" Style="{StaticResource BodyText}" HorizontalAlignment="Center" />
                    <TextBlock Text="在播报台点击「立即播报」试试" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
