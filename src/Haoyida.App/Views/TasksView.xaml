<UserControl x:Class="Haoyida.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Haoyida.ViewModels">
    <UserControl.Resources>
        <vm:KeyToBrush x:Key="KeyBrush" />
        <vm:BoolToVisibility x:Key="BoolToVis" />
        <vm:PercentConverter x:Key="Percent" />
        <vm:IndexMatchToVisibility x:Key="IdxVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="392" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="全部计划" Style="{StaticResource H3Text}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Background="{StaticResource Surface3Brush}">
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}">
                            <Run Text="{Binding Tasks.Count, Mode=OneWay}" /><Run Text=" 项" />
                        </TextBlock>
                    </Border>
                </StackPanel>
                <Button Content="+ 新建计划" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right"
                        Command="{Binding NewTaskCommand}" Padding="14,7" />
            </Grid>

            <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Tasks}"
                     SelectedItem="{Binding SelectedTask, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardGradient}" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,2,10,2"
                                        Background="{Binding StateBrushKey, Converter={StaticResource KeyBrush}}" />

                                <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="7,2">
                                            <TextBlock Text="{Binding KindText}" FontSize="10" Foreground="{StaticResource TextDimBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Padding="7,2">
                                            <TextBlock Text="{Binding SourceText}" FontSize="10" Foreground="{StaticResource TextDimBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PatternText}" FontSize="12" Margin="0,6,0,0"
                                               Foreground="{StaticResource TextFaintBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding StateText}" FontSize="11.5" HorizontalAlignment="Right"
                                               Foreground="{Binding StateBrushKey, Converter={StaticResource KeyBrush}}" />
                                    <TextBlock FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextFaintBrush}">
                                        <Run Text="下次 " /><Run Text="{Binding NextRunText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="10.5" Margin="0,2,0,0" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextFaintBrush}">
                                        <Run Text="已播 " /><Run Text="{Binding RunCount, Mode=OneWay}" /><Run Text=" 次" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ===== 编辑面板 ===== -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <StackPanel Visibility="{Binding HasSelectedTask, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="选择左侧计划进行编辑" Style="{StaticResource BodyText}" HorizontalAlignment="Center" />
                    <TextBlock Text="或点击「新建计划」" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <Grid Visibility="{Binding HasSelectedTask, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="计划设置" Style="{StaticResource H3Text}" VerticalAlignment="Center" />
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SelectedTask.Enabled}"
                                      HorizontalAlignment="Right" Margin="10,0,0,0" ToolTip="启用 / 暂停" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="计划名称" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource TextInput}" Text="{Binding SelectedTask.Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="执行方式" Style="{StaticResource LabelCaps}" Margin="0,14,0,6" />
                            <ComboBox Style="{StaticResource Combo}" SelectedIndex="{Binding TaskKindIndex}">
                                <ComboBoxItem Content="每天固定时间" />
                                <ComboBoxItem Content="每周指定日期" />
                                <ComboBoxItem Content="时段内循环" />
                                <ComboBoxItem Content="仅播一次" />
                            </ComboBox>

                            <StackPanel Visibility="{Binding TaskKindIndex, Converter={StaticResource IdxVis}, ConverterParameter=1}">
                                <TextBlock Text="星期" Style="{StaticResource LabelCaps}" Margin="0,14,0,6" />
                                <ComboBox Style="{StaticResource Combo}" SelectedIndex="{Binding WeeklyDayIndex}">
                                    <ComboBoxItem Content="每天" /><ComboBoxItem Content="周一" /><ComboBoxItem Content="周二" />
                                    <ComboBoxItem Content="周三" /><ComboBoxItem Content="周四" /><ComboBoxItem Content="周五" />
                                    <ComboBoxItem Content="周六" /><ComboBoxItem Content="周日" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Visibility="{Binding TaskKindIndex, Converter={StaticResource IdxVis}, ConverterParameter=2}">
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="开始时间" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource TextInput}" Text="{Binding SelectedTask.StartTime}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="结束时间" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource TextInput}" Text="{Binding SelectedTask.EndTime}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="循环间隔（分钟）" Style="{StaticResource LabelCaps}" Margin="0,14,0,6" />
                                <TextBox Style="{StaticResource TextInput}" Text="{Binding SelectedTask.IntervalMinutes}" />
                            </StackPanel>

                            <TextBlock Text="播报时间" Style="{StaticResource LabelCaps}" Margin="0,14,0,6"
                                       Visibility="{Binding TaskKindIndex, Converter={StaticResource IdxVis}, ConverterParameter=0}" />
                            <TextBox Style="{StaticResource TextInput}" Text="{Binding SelectedTask.Time}"
                                     Visibility="{Binding TaskKindIndex, Converter={StaticResource IdxVis}, ConverterParameter=0}" />
                            <TextBlock Text="播报时间" Style="{StaticResource LabelCaps}" Margin="0,14,0,6"
                                       Visibility="{Binding TaskKindIndex, Converter={StaticResource IdxVis}, ConverterParameter=1}" />
                            <TextBox Style="{StaticResource TextInput}" Text="{Binding SelectedTask.Time}"
                                     Visibility="{Binding TaskKindIndex, Converter={StaticResource IdxVis}, ConverterParameter=1}" />

                            <Border Style="{StaticResource Divider}" Margin="0,18,0,14" />

                            <TextBlock Text="播报内容来源" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                            <ComboBox Style="{StaticResource Combo}" SelectedIndex="{Binding TaskSourceIndex}">
                                <ComboBoxItem Content="文案库" />
                                <ComboBoxItem Content="促销商品" />
                                <ComboBoxItem Content="自由文本" />
                                <ComboBoxItem Content="录音文件" />
                            </ComboBox>

                            <StackPanel Visibility="{Binding TaskSourceIndex, Converter={StaticResource IdxVis}, ConverterParameter=0}">
                                <TextBlock Text="选择文案" Style="{StaticResource LabelCaps}" Margin="0,14,0,6" />
                                <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Scripts}"
                                          SelectedValuePath="Id" SelectedValue="{Binding SelectedTask.ScriptId, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Visibility="{Binding TaskSourceIndex, Converter={StaticResource IdxVis}, ConverterParameter=1}">
                                <TextBlock Text="选择商品" Style="{StaticResource LabelCaps}" Margin="0,14,0,6" />
                                <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Products}"
                                          SelectedValuePath="Id" SelectedValue="{Binding SelectedTask.ProductId, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="将按「商品名 + 原价 + 现价」自动生成口语播报词" Style="{StaticResource CaptionText}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding TaskSourceIndex, Converter={StaticResource IdxVis}, ConverterParameter=2}">
                                <TextBlock Text="播报词" Style="{StaticResource LabelCaps}" Margin="0,14,0,6" />
                                <TextBox Style="{StaticResource TextArea}" MinHeight="88"
                                         Text="{Binding SelectedTask.FreeText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Border Style="{StaticResource Divider}" Margin="0,18,0,14" />

                            <TextBlock Text="播报音色" Style="{StaticResource LabelCaps}" Margin="0,16,0,6" />
                            <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding TaskEngineOptions}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding TaskEngineId, Mode=TwoWay}" />
                            <ComboBox Style="{StaticResource Combo}" Margin="0,8,0,0" ItemsSource="{Binding TaskVoices}"
                                      SelectedValuePath="Id" SelectedValue="{Binding TaskVoiceId, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13" />
                                            <TextBlock Text="{Binding Style}" FontSize="10.5" Margin="8,2,0,0"
                                                       Foreground="{StaticResource TextFaintBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                                       Text="选「跟随默认音色」即使用全局默认；换引擎后音色列表会自动刷新。" />

                            <Border Style="{StaticResource Divider}" Margin="0,14,0,10" />                            <TextBlock Text="优先级（0 插播 / 10 计划 / 20 轮播）" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource TextInput}" Text="{Binding SelectedTask.Priority}" />

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="本条音量" Style="{StaticResource LabelCaps}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedTask.Volume, Converter={StaticResource Percent}}"
                                           HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <Slider Style="{StaticResource FlatSlider}" Minimum="0.1" Maximum="1.0"
                                    Value="{Binding SelectedTask.Volume}" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="立即播报一次" Style="{StaticResource SecondaryBtn}"
                                Command="{Binding RunTaskCommand}" FontSize="12.5" />
                        <Button Grid.Column="1" Content="删除" Style="{StaticResource DangerBtn}" Margin="8,0,0,0"
                                Command="{Binding DeleteTaskCommand}" FontSize="12.5" />
                        <Button Grid.Column="2" Content="保存" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"
                                Command="{Binding SaveCommand}" FontSize="12.5" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
