<UserControl x:Class="Haoyida.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Haoyida.ViewModels">
    <UserControl.Resources>
        <vm:KeyToBrush x:Key="KeyBrush" />
        <vm:BoolToVisibility x:Key="BoolToVis" />
        <vm:ZeroToVisibility x:Key="ZeroVis" />
        <vm:NotEmptyToVisibility x:Key="NotEmpty" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ===== 主状态卡 ===== -->
            <Border Style="{StaticResource Card}" Background="{StaticResource HeroGradient}" Padding="26,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource OkSoftBrush}" CornerRadius="999" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{Binding RunStateKey, Converter={StaticResource KeyBrush}}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RunStateText}" Margin="6,0,0,0" FontSize="11.5"
                                               Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="#14FFFFFF" CornerRadius="999" Padding="10,4" Margin="8,0,0,0">
                                <TextBlock Text="{Binding CurrentStateText}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource DisplayText}" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding CurrentText}" Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" />

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <TextBox Style="{StaticResource TextInput}" Height="40" Padding="14,0"
                                         Background="#1AFFFFFF" BorderBrush="#33FFFFFF"
                                         Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="支持 {店名} {商品} {时间} 等变量" />
                                <TextBlock Text="输入要播报的内容，支持 {店名} {商品} {时间} 变量" IsHitTestVisible="False"
                                           Margin="15,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#7C7C88"
                                           Visibility="{Binding QuickText, Converter={StaticResource NotEmpty}, ConverterParameter=invert}" />
                            </Grid>
                            <Button Grid.Column="1" Content="立即播报" Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding SpeakQuickCommand}" Margin="10,0,0,0" Height="40" />
                            <Button Grid.Column="2" Content="紧急插播" Style="{StaticResource DangerBtn}"
                                    Command="{Binding InterruptCommand}" Margin="8,0,0,0" Height="40" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#0FFFFFFF" CornerRadius="10" Padding="20" Margin="24,0,0,0"
                            BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="下一条播报" Style="{StaticResource LabelCaps}" />
                            <TextBlock Text="{Binding CountdownText}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"
                                       Foreground="{StaticResource TextBrush}" />
                            <Border Height="1" Background="#1AFFFFFF" Margin="0,14" />
                            <Grid>
                                <TextBlock Text="今日已播" Style="{StaticResource CaptionText}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="12.5" Foreground="{StaticResource OkBrush}">
                                    <Run Text="{Binding TodayCount, Mode=OneWay}" /><Run Text=" 条" />
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="计划任务" Style="{StaticResource CaptionText}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="12.5" Foreground="{StaticResource TextBrush}">
                                    <Run Text="{Binding EnabledTaskCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Tasks.Count, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="排队中" Style="{StaticResource CaptionText}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="12.5" Foreground="{StaticResource AccentBrush}">
                                    <Run Text="{Binding QueueCount, Mode=OneWay}" /><Run Text=" 条" />
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== 指标卡 ===== -->
            <UniformGrid Columns="3" Margin="0,14,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,7,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="今日播报" Style="{StaticResource LabelCaps}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding TodayCount}" FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="条" Margin="6,0,0,6" VerticalAlignment="Bottom" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <TextBlock Text="{Binding LastBroadcastText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="7,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="在跑计划" Style="{StaticResource LabelCaps}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding EnabledTaskCount}" FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="项" Margin="6,0,0,6" VerticalAlignment="Bottom" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0">
                            <Run Text="文案 " /><Run Text="{Binding ScriptCount, Mode=OneWay}" /><Run Text=" · 商品 " />
                            <Run Text="{Binding ProductCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="7,0,0,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="缓存音色" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="{Binding CacheText}" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="相同文案第二次播报零延迟" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 官方推广位：门店老板扫码关注 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="64" Height="64" CornerRadius="8" Background="#FFFFFF" Padding="4">
                        <Image Source="pack://application:,,,/Assets/wechat-qr.jpg" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="耗易达 · 超市老板的好帮手" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="扫码关注官方微信公众号，获取新版通知、播报文案模板与门店运营小技巧"
                                   FontSize="11.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextFaintBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border Style="{StaticResource Chip}" Background="{StaticResource OkSoftBrush}" BorderBrush="#2A10B981">
                            <TextBlock Text="官方公众号" FontSize="10.5" Foreground="{StaticResource OkBrush}" />
                        </Border>
                        <TextBlock Text="耗易达" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextFaintBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <!-- ===== 队列 + 节奏 ===== -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="播报队列" Style="{StaticResource H3Text}" />
                            <Button Content="清空" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right"
                                    Padding="10,4" FontSize="11.5" Command="{Binding ClearQueueCommand}" />
                        </Grid>
                        <TextBlock Text="插播优先于计划，计划优先于轮播" Style="{StaticResource CaptionText}" Margin="0,4,0,12" />

                        <ItemsControl ItemsSource="{Binding Engine.Queue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface1Brush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,7"
                                            BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource Surface3Brush}" CornerRadius="5"
                                                    Padding="7,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PriorityText}" FontSize="10.5"
                                                           Foreground="{Binding StateKey, Converter={StaticResource KeyBrush}}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Text}" FontSize="11.5" Margin="0,2,0,0"
                                                           Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateText}" FontSize="11"
                                                           Foreground="{Binding StateKey, Converter={StaticResource KeyBrush}}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding TimeText}" FontSize="10.5" Margin="0,2,0,0"
                                                           Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Panel}" Margin="0,4,0,0" Padding="14,12"
                                Visibility="{Binding Engine.Queue.Count, Converter={StaticResource ZeroVis}}">
                            <TextBlock Text="队列为空，点击右上角切换值守或直接手动播报。" Style="{StaticResource CaptionText}" />
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="今日节奏" Style="{StaticResource H3Text}" />
                            <TextBlock Text="按小时统计已完成的播报" Style="{StaticResource CaptionText}" Margin="0,4,0,14" />
                            <ItemsControl ItemsSource="{Binding HourBars}"
                                          Visibility="{Binding TodayCount, Converter={StaticResource ZeroVis}, ConverterParameter=invert}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Bottom" Margin="2,0">
                                            <Border Height="{Binding Height}" CornerRadius="3" Background="{StaticResource AccentBrush}"
                                                    Opacity="0.85" VerticalAlignment="Bottom" ToolTip="{Binding Count}" />
                                            <TextBlock Text="{Binding Label}" FontSize="9" Margin="0,6,0,0"
                                                       Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="56" Visibility="{Binding TodayCount, Converter={StaticResource ZeroVis}}">
                                <TextBlock Text="今日还没有播报，节奏图会在第一条播报后出现" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="接下来的排期" Style="{StaticResource H3Text}" />
                            <TextBlock Text="按时间顺序预告" Style="{StaticResource CaptionText}" Margin="0,4,0,12" />
                            <ItemsControl ItemsSource="{Binding Upcoming}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="11"
                                                       Foreground="{StaticResource TextFaintBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
</StackPanel>
    </ScrollViewer>
</UserControl>
