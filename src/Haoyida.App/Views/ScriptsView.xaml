<UserControl x:Class="Haoyida.Views.ScriptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Haoyida.ViewModels">
    <UserControl.Resources>
        <vm:KeyToBrush x:Key="KeyBrush" />
        <vm:BoolToVisibility x:Key="BoolToVis" />
        <vm:NotEmptyToVisibility x:Key="NotEmpty" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="392" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="{StaticResource Surface2Brush}" CornerRadius="999"
                                                Padding="12,5" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="TextBlock.Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextDimBrush}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Column="1" Width="200" HorizontalAlignment="Right" Margin="12,0,10,0">
                    <TextBox Style="{StaticResource TextInput}" Height="38"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索标题或正文" />
                    <TextBlock Text="搜索文案…" IsHitTestVisible="False" Margin="13,0,0,0" VerticalAlignment="Center"
                               FontSize="12.5" Foreground="{StaticResource TextFaintBrush}"
                               Visibility="{Binding SearchText, Converter={StaticResource NotEmpty}, ConverterParameter=invert}" />
                </Grid>

                <Button Grid.Column="2" Content="+ 新建文案" Style="{StaticResource PrimaryBtn}" Padding="14,7"
                        Command="{Binding NewScriptCommand}" />
            </Grid>

            <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding ScriptView}"
                     SelectedItem="{Binding SelectedScript, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardGradient}" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="7,2">
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextDimBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PlayCount, StringFormat=播过 {0} 次}" HorizontalAlignment="Right"
                                               FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding BodyPreview}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextFaintBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <StackPanel Visibility="{Binding HasSelectedScript, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="选择左侧文案开始编辑" Style="{StaticResource BodyText}" />
                    <TextBlock Text="支持 {店名} {商品} {现价} 等变量" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Grid Visibility="{Binding HasSelectedScript, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="文案编辑" Style="{StaticResource H3Text}" Margin="0,0,0,14" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="标题" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource TextInput}" Text="{Binding SelectedScript.Title, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="分类" Style="{StaticResource LabelCaps}" Margin="0,14,0,6" />
                            <TextBox Style="{StaticResource TextInput}" Text="{Binding SelectedScript.Category, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="播报词" Style="{StaticResource LabelCaps}" Margin="0,14,0,6" />
                            <TextBox Style="{StaticResource TextArea}" MinHeight="150"
                                     Text="{Binding SelectedScript.Body, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="插入变量" Style="{StaticResource LabelCaps}" Margin="0,14,0,8" />
                            <WrapPanel>
                                <Button Content="{}{店名}" Style="{StaticResource GhostBtn}" Padding="8,4" Margin="0,0,6,6"
                                        FontSize="11" Command="{Binding InsertTokenCommand}" CommandParameter="{}{店名}" />
                                <Button Content="{}{分店}" Style="{StaticResource GhostBtn}" Padding="8,4" Margin="0,0,6,6"
                                        FontSize="11" Command="{Binding InsertTokenCommand}" CommandParameter="{}{分店}" />
                                <Button Content="{}{商品}" Style="{StaticResource GhostBtn}" Padding="8,4" Margin="0,0,6,6"
                                        FontSize="11" Command="{Binding InsertTokenCommand}" CommandParameter="{}{商品}" />
                                <Button Content="{}{原价}" Style="{StaticResource GhostBtn}" Padding="8,4" Margin="0,0,6,6"
                                        FontSize="11" Command="{Binding InsertTokenCommand}" CommandParameter="{}{原价}" />
                                <Button Content="{}{现价}" Style="{StaticResource GhostBtn}" Padding="8,4" Margin="0,0,6,6"
                                        FontSize="11" Command="{Binding InsertTokenCommand}" CommandParameter="{}{现价}" />
                                <Button Content="{}{立省}" Style="{StaticResource GhostBtn}" Padding="8,4" Margin="0,0,6,6"
                                        FontSize="11" Command="{Binding InsertTokenCommand}" CommandParameter="{}{立省}" />
                                <Button Content="{}{时间}" Style="{StaticResource GhostBtn}" Padding="8,4" Margin="0,0,6,6"
                                        FontSize="11" Command="{Binding InsertTokenCommand}" CommandParameter="{}{时间}" />
                                <Button Content="{}{星期}" Style="{StaticResource GhostBtn}" Padding="8,4" Margin="0,0,6,6"
                                        FontSize="11" Command="{Binding InsertTokenCommand}" CommandParameter="{}{星期}" />
                            </WrapPanel>

                            <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="效果预览" Style="{StaticResource LabelCaps}" />
                                    <TextBlock Margin="0,7,0,0" FontSize="12.5" TextWrapping="Wrap" LineHeight="21"
                                               Foreground="{StaticResource TextDimBrush}">
                                        <Run Text="{Binding ScriptPreview, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="试听" Style="{StaticResource SecondaryBtn}"
                                Command="{Binding PreviewScriptCommand}" FontSize="12.5" />
                        <Button Grid.Column="1" Content="删除" Style="{StaticResource DangerBtn}" Margin="8,0,0,0"
                                Command="{Binding DeleteScriptCommand}" FontSize="12.5" />
                        <Button Grid.Column="2" Content="保存" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"
                                Command="{Binding SaveCommand}" FontSize="12.5" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
