<UserControl x:Class="Haoyida.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Haoyida.ViewModels">
    <UserControl.Resources>
        <vm:KeyToBrush x:Key="KeyBrush" />
        <vm:PercentConverter x:Key="Percent" />
        <vm:ZeroToVisibility x:Key="ZeroVis" />
        <vm:BoolToVisibility x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 正在播放 ===== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource HeroGradient}" Padding="20,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="11" Background="#1A3B9EFF" VerticalAlignment="Center">
                    <TextBlock Text="♪" FontSize="20" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentMusicTitle}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentMusicTaskName}" FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="音乐音量" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="{Binding Profile.BgmVolume, Converter={StaticResource Percent}}" HorizontalAlignment="Right"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                    <Slider Style="{StaticResource FlatSlider}" Minimum="0" Maximum="1" Value="{Binding Profile.BgmVolume}"
                            Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="切歌" Style="{StaticResource SecondaryBtn}" Padding="12,7" FontSize="12"
                            Command="{Binding NextMusicCommand}" />
                    <Button Content="停止" Style="{StaticResource GhostBtn}" Padding="12,7" FontSize="12" Margin="8,0,0,0"
                            Command="{Binding StopMusicCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 任务 + 编辑 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="音乐任务" Style="{StaticResource H3Text}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Chip}" Margin="10,0,0,0">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}">
                                <Run Text="{Binding MusicTasks.Count, Mode=OneWay}" /><Run Text=" 个时段" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <Button Content="+ 新建任务" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right"
                            Padding="14,7" Command="{Binding NewMusicTaskCommand}" />
                </Grid>

                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding MusicTasks}"
                         SelectedItem="{Binding SelectedMusicTask, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardGradient}" BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,2,10,2"
                                            Background="{Binding StateBrushKey, Converter={StaticResource KeyBrush}}" />

                                    <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="7,2">
                                                <TextBlock Text="{Binding ModeText}" FontSize="10" Foreground="{StaticResource TextDimBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource TextFaintBrush}">
                                            <Run Text="{Binding WindowText, Mode=OneWay}" /><Run Text=" · " />
                                            <Run Text="{Binding TrackCount, Mode=OneWay}" /><Run Text=" 首" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" HorizontalAlignment="Right"
                                                   Foreground="{Binding StateBrushKey, Converter={StaticResource KeyBrush}}" />
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"
                                                      Margin="0,6,0,0" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 曲库 -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,14" Margin="0,4,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="曲库" Style="{StaticResource H3Text}" />
                            <Button Content="+ 添加本地音频" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Right"
                                    Padding="12,6" FontSize="11.5" Command="{Binding AddMusicFilesCommand}" />
                        </Grid>
                        <TextBlock Text="点一下即可把曲目加入当前任务；支持 mp3 / wav / wma / m4a / aac / flac，可多选"
                                   Style="{StaticResource CaptionText}" Margin="0,5,0,10" TextWrapping="Wrap" />
                        <Border Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="8"
                                Padding="11,9" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="个人会员 ≠ 公播授权" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarnBrush}" />
                                    <TextBlock Text="门店用音响、电视向顾客放歌属于公开表演，需另办许可或购买线下公播授权。"
                                               FontSize="10.5" Margin="0,3,10,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextFaintBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="查看说明" Style="{StaticResource GhostBtn}"
                                        Padding="9,4" FontSize="10.5" VerticalAlignment="Center"
                                        Command="{Binding ShowComplianceCommand}" />
                            </Grid>
                        </Border>                        <ItemsControl ItemsSource="{Binding MusicLibrary}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostBtn}" Padding="10,5" Margin="0,0,6,6" FontSize="11"
                                            Command="{Binding DataContext.AddLibraryTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+ " Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextDimBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 编辑面板 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSelectedMusicTask, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="选择左侧音乐任务进行编辑" Style="{StaticResource BodyText}" />
                    </StackPanel>

                    <Grid Visibility="{Binding HasSelectedMusicTask, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="任务设置" Style="{StaticResource H3Text}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SelectedMusicTask.Enabled}"
                                          HorizontalAlignment="Right" Margin="10,0,0,0" ToolTip="启用 / 停用" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="任务名称" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource TextInput}"
                                         Text="{Binding SelectedMusicTask.Name, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="开始时间" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource TextInput}" Text="{Binding SelectedMusicTask.StartTime}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="结束时间" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource TextInput}" Text="{Binding SelectedMusicTask.EndTime}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="循环播放" FontSize="12.5" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="列表播完回到第一首" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SelectedMusicTask.Loop}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="随机播放" FontSize="12.5" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="从列表中随机挑歌" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SelectedMusicTask.Shuffle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="按星期播放" Style="{StaticResource LabelCaps}" Margin="0,16,0,6" />
                                <ComboBox Style="{StaticResource Combo}" SelectedIndex="{Binding MusicWeekdayIndex}">
                                    <ComboBoxItem Content="每天" />
                                    <ComboBoxItem Content="周一至周五" />
                                    <ComboBoxItem Content="周六、周日" />
                                </ComboBox>

                                <Border Style="{StaticResource Divider}" Margin="0,18,0,14" />

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="播放列表" Style="{StaticResource LabelCaps}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MusicTaskTracks.Count, StringFormat=共 {0} 首}" HorizontalAlignment="Right"
                                               FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding MusicTaskTracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface1Brush}" CornerRadius="8" Padding="11,9" Margin="0,0,0,6"
                                                    BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding KindText}" FontSize="10" Margin="0,3,0,0"
                                                                   Foreground="{StaticResource TextFaintBrush}" />
                                                    </StackPanel>
                                                    <Button Content="移除" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right"
                                                            Padding="8,3" FontSize="10.5" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RemoveTaskTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="40" Visibility="{Binding MusicTaskTracks.Count, Converter={StaticResource ZeroVis}}">
                                    <TextBlock Text="列表为空，点下方按钮添加本地音频" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <Button Content="添加本地音频到本任务" Style="{StaticResource SecondaryBtn}"
                                    Command="{Binding AddMusicFilesCommand}" FontSize="12.5" />
                            <Button Content="添加前先看：门店背景音乐版权合规说明" Style="{StaticResource GhostBtn}"
                                    Margin="0,6,0,0" FontSize="11" Padding="8,5" HorizontalAlignment="Left"
                                    Command="{Binding ShowComplianceCommand}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="立即播放本任务" Style="{StaticResource PrimaryBtn}"
                                        Command="{Binding PlayMusicTaskCommand}" FontSize="12.5" />
                                <Button Grid.Column="1" Content="删除" Style="{StaticResource DangerBtn}" Margin="8,0,0,0"
                                        Command="{Binding DeleteMusicTaskCommand}" FontSize="12.5" />
                                <Button Grid.Column="2" Content="保存" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"
                                        Command="{Binding SaveCommand}" FontSize="12.5" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
