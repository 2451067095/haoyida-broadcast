<UserControl x:Class="Haoyida.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Haoyida.ViewModels">
    <UserControl.Resources>
        <vm:KeyToBrush x:Key="KeyBrush" />
        <vm:PercentConverter x:Key="Percent" />
        <vm:NotEmptyToVisibility x:Key="NotEmpty" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,7,0">
                <!-- 门店 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="门店信息" Style="{StaticResource H3Text}" />
                        <TextBlock Text="播报词里的 {店名}、{分店}、{电话} 会取这里的值" Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,14" TextWrapping="Wrap" />

                        <TextBlock Text="门店名称" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource TextInput}" Text="{Binding Profile.StoreName, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="分店" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource TextInput}" Text="{Binding Profile.Branch, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="服务电话" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource TextInput}" Text="{Binding Profile.Phone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="营业开始" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource TextInput}" Text="{Binding Profile.OpenTime}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="营业结束" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource TextInput}" Text="{Binding Profile.CloseTime}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 背景音乐 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="背景音乐" Style="{StaticResource H3Text}" />
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Profile.BgmEnabled}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="人声播报时自动压低 BGM（闪避），播完自动恢复" Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,14" TextWrapping="Wrap" />

                        <Border Style="{StaticResource Panel}" Padding="12,10">
                            <Grid>
                                <Grid Margin="0,0,70,0">
                                    <TextBlock Text="{Binding Profile.BgmPath}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextDimBrush}"
                                               Visibility="{Binding Profile.BgmPath, Converter={StaticResource NotEmpty}}" />
                                    <TextBlock Text="未选择背景音乐（支持 mp3 / wav / wma / m4a）" FontSize="11.5"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               Visibility="{Binding Profile.BgmPath, Converter={StaticResource NotEmpty}, ConverterParameter=invert}" />
                                </Grid>
                                <Button Content="选择…" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right"
                                        Padding="10,4" FontSize="11" Command="{Binding ChooseBgmCommand}" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="BGM 音量" Style="{StaticResource LabelCaps}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Profile.BgmVolume, Converter={StaticResource Percent}}"
                                       HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                        <Slider Style="{StaticResource FlatSlider}" Minimum="0" Maximum="1" Value="{Binding Profile.BgmVolume}"
                                Margin="0,4,0,0" />

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="总音量" Style="{StaticResource LabelCaps}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Profile.MasterVolume, Converter={StaticResource Percent}}"
                                       HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                        <Slider Style="{StaticResource FlatSlider}" Minimum="0.1" Maximum="1" Value="{Binding Profile.MasterVolume}"
                                Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 播报偏好 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="播报偏好" Style="{StaticResource H3Text}" />
                        <TextBlock Text="决定数字怎么读、默认用哪个音色" Style="{StaticResource CaptionText}" Margin="0,4,0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="价格按中文口语播报" FontSize="12.5" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="9.9 → 九块九；19.80 → 十九块八" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Profile.ReadPriceAsChinese}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="开机自动启动" FontSize="12.5" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding AutoStartHint}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />

                        <TextBlock Text="默认引擎 / 音色" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextDimBrush}">
                            <Run Text="{Binding Profile.DefaultEngineId, Mode=OneWay}" /><Run Text=" · " />
                            <Run Text="{Binding Profile.DefaultVoiceId, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="在「音色引擎」页选中音色即可修改默认值" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                <!-- 数据 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="数据与缓存" Style="{StaticResource H3Text}" />
                        <TextBlock Text="所有配置保存在本机 JSON，随时可整目录备份" Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,14" TextWrapping="Wrap" />

                        <Border Style="{StaticResource Panel}" Padding="12,10">
                            <TextBlock Text="{Binding DataFolder}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDimBrush}" />
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="语音缓存" Style="{StaticResource LabelCaps}" />
                                <TextBlock Text="{Binding CacheText}" FontSize="11.5" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextDimBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="清空缓存" Style="{StaticResource GhostBtn}" Padding="10,5"
                                    FontSize="11" Command="{Binding ClearCacheCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="自动清理未使用的语音缓存" Style="{StaticResource LabelCaps}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="保留" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" />
                                    <TextBox Style="{StaticResource TextInput}" Width="56" Height="30" Margin="6,0"
                                             Text="{Binding Profile.CacheDays, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="天" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" />
                                    <Button Content="立即清理" Style="{StaticResource GhostBtn}" Padding="9,4" FontSize="10.5"
                                            Margin="10,0,0,0" Command="{Binding CleanOldCacheCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="打开数据目录" Style="{StaticResource SecondaryBtn}" Command="{Binding OpenDataFolderCommand}"
                                    FontSize="12" Padding="12,7" HorizontalAlignment="Left" />
                            <Button Grid.Column="1" Content="保存全部设置" Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding SaveCommand}" FontSize="12" Padding="14,7" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 引擎许可 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="语音引擎与许可" Style="{StaticResource H3Text}" />
                        <TextBlock Text="本软件不内置任何第三方语音模型，仅在检测到本地运行时时启用" Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,14" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding EngineCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock FontSize="10.5" Margin="0,3,0,0" Foreground="{StaticResource TextFaintBrush}">
                                                <Run Text="{Binding Vendor, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding License, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="10.5" VerticalAlignment="Center"
                                                   Foreground="{Binding StatusBrushKey, Converter={StaticResource KeyBrush}}"
                                                   MaxWidth="140" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 关注官方公众号 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="关注耗易达" Style="{StaticResource H3Text}" />
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Background="{StaticResource OkSoftBrush}"
                                    BorderBrush="#2A10B981" Padding="8,2">
                                <TextBlock Text="官方" FontSize="10" Foreground="{StaticResource OkBrush}" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="132" Height="132" CornerRadius="10" Background="#FFFFFF" Padding="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Color="#000000" />
                                </Border.Effect>
                                <Image Source="pack://application:,,,/Assets/wechat-qr.jpg" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,2,0,0">
                                <TextBlock Text="耗易达，超市老板的好帮手" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="扫码关注官方微信公众号，第一时间获取版本更新、门店播报文案模板与运营小技巧。"
                                           FontSize="11.5" LineHeight="19" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock Text="微信公众号 · 耗易达" FontSize="11" Margin="0,10,0,0"
                                           Foreground="{StaticResource TextFaintBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- 关于 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource H3Text}" />
                        <TextBlock Text="耗易达-超市播音软件" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="版本 1.0.0 · 原创实现" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        <TextBlock Text="开发公司：深圳市耗易达供应链管理有限公司" Style="{StaticResource CaptionText}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Border Style="{StaticResource Divider}" Margin="0,14" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="19">
                            界面设计规范来自 GitHub awesome-design-skills 的 dashboard 设计系统（MIT）。语音能力通过可插拔引擎接入，代码与资源均为独立实现。
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
