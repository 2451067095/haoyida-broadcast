<UserControl x:Class="Haoyida.Views.VoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Haoyida.ViewModels">
    <UserControl.Resources>
        <vm:KeyToBrush x:Key="KeyBrush" />
        <vm:PercentConverter x:Key="Percent" />
        <vm:BoolToVisibility x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 引擎卡 ===== -->
        <ListBox Grid.Row="0" ItemsSource="{Binding EngineCards}" SelectedItem="{Binding SelectedEngine, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Margin="0,0,0,14"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,10,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="bd" Background="{StaticResource CardGradient}" CornerRadius="12"
                                        Padding="16,14" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="bd" Property="Background" Value="#16202E" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#3A6EA8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Surface3Brush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding Glyph}" FontSize="15" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                            <Grid>
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Padding="7,2">
                                    <TextBlock Text="{Binding Kind}" FontSize="9.5" Foreground="{StaticResource TextFaintBrush}" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                         Fill="{Binding StatusBrushKey, Converter={StaticResource KeyBrush}}" />
                                <TextBlock Text="{Binding Status}" FontSize="10.5" Margin="5,0,0,0"
                                           Foreground="{Binding StatusBrushKey, Converter={StaticResource KeyBrush}}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </StackPanel>
                            <TextBlock Text="{Binding VoiceCountText}" FontSize="10.5" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextFaintBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== 音色 + 调音 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="可选音色" Style="{StaticResource H3Text}" />
                        <TextBlock Text="{Binding SelectedEngine.Note}" Style="{StaticResource CaptionText}" Margin="0,5,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Voices}"
                             SelectedItem="{Binding SelectedVoice, Mode=TwoWay}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="9" BorderThickness="1"
                                                    BorderBrush="Transparent" Padding="1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="bd" Property="Background" Value="#1A3B9EFF" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#3A6EA8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface1Brush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,7"
                                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <Border Style="{StaticResource Chip}" Margin="7,0,0,0" Padding="6,1">
                                                    <TextBlock Text="{Binding Gender}" FontSize="9.5" Foreground="{StaticResource TextDimBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Margin="5,0,0,0" Padding="6,1">
                                                    <TextBlock Text="{Binding Style}" FontSize="9.5" Foreground="{StaticResource TextDimBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="10.5" Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextFaintBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="试听" Style="{StaticResource GhostBtn}"
                                                Padding="9,3" FontSize="10.5" VerticalAlignment="Center"
                                                Command="{Binding DataContext.PreviewVoiceItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="播报风格" Style="{StaticResource H3Text}" />
                        <TextBlock Text="一键套用语速与音调，也可以单独微调" Style="{StaticResource CaptionText}" Margin="0,4,0,12" />

                        <ListBox ItemsSource="{Binding StyleOptions}" SelectedValue="{Binding StyleId, Mode=TwoWay}"
                                 SelectedValuePath="Id" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Margin" Value="0,0,6,6" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="{StaticResource Surface2Brush}" CornerRadius="8"
                                                        Padding="11,6" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="TextBlock.Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Style="{StaticResource Divider}" Margin="0,10,0,14" />

                        <Grid>
                            <TextBlock Text="语速" Style="{StaticResource LabelCaps}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Rate, StringFormat={}{0:0.00}x}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                        <Slider Style="{StaticResource FlatSlider}" Minimum="0.6" Maximum="1.6" Value="{Binding Rate}" Margin="0,4,0,10" />

                        <Grid>
                            <TextBlock Text="音调" Style="{StaticResource LabelCaps}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Pitch, StringFormat={}{0:0.00}x}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                        <Slider Style="{StaticResource FlatSlider}" Minimum="0.7" Maximum="1.4" Value="{Binding Pitch}" Margin="0,4,0,14" />

                        <TextBlock Text="试听文本" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource TextArea}" MinHeight="72"
                                 Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="{Binding PreviewButtonText}" Style="{StaticResource PrimaryBtn}" Margin="0,12,0,0"
                                Command="{Binding PreviewVoiceCommand}" Height="40" />

                        <TextBlock Text="{Binding VoiceDiagText}" FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource AccentBrush}" />

                        <Grid Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="当前默认音色" Style="{StaticResource LabelCaps}" />
                                <TextBlock Text="{Binding DefaultVoiceText}" FontSize="11.5" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                            </StackPanel>
                            <Button Content="设为默认音色" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Padding="12,6" FontSize="11.5"
                                    Command="{Binding SetDefaultVoiceCommand}" />
                        </Grid>

                        <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="语音缓存" Style="{StaticResource LabelCaps}" />
                                    <TextBlock Text="{Binding CacheText}" FontSize="12" Margin="0,5,0,0"
                                               Foreground="{StaticResource TextDimBrush}" />
                                </StackPanel>
                                <Button Content="清空" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right"
                                        Padding="10,5" FontSize="11" Command="{Binding ClearCacheCommand}" />
                            </Grid>
                        </Border>
                                            <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="第三方语音模型" Style="{StaticResource LabelCaps}" VerticalAlignment="Center" />
                                    <Button Content="+ 安装模型" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right"
                                            Padding="9,4" FontSize="10.5" Command="{Binding InstallModelCommand}" />
                                </Grid>
                                <TextBlock Text="支持本地命令行程序或 HTTP 推理服务（如 MiMo、CosyVoice、自建服务）"
                                           Style="{StaticResource CaptionText}" Margin="0,6,0,8" TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{Binding CustomModels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface1Brush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                                    BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="10" Margin="0,3,0,0" Foreground="{StaticResource TextFaintBrush}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding ModeText, Mode=OneWay}" /><Run Text=" · " />
                                                            <Run Text="{Binding Summary, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="启动服务" Style="{StaticResource GhostBtn}" Padding="7,3" FontSize="10"
                                                                Command="{Binding DataContext.StartModelServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="停止" Style="{StaticResource GhostBtn}" Padding="7,3" FontSize="10" Margin="4,0,0,0"
                                                                Command="{Binding DataContext.StopModelServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="编辑" Style="{StaticResource GhostBtn}" Padding="7,3" FontSize="10" Margin="4,0,0,0"
                                                                Command="{Binding DataContext.EditModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="移除" Style="{StaticResource GhostBtn}" Padding="7,3" FontSize="10" Margin="4,0,0,0"
                                                                Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="还没有安装第三方模型。点「+ 安装模型」填写命令或接口地址即可。"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Visibility="{Binding HasCustomModels, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Border></StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
