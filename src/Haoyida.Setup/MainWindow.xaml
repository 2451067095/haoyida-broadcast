<Window x:Class="Haoyida.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="耗易达-超市播音软件 安装程序" Width="760" Height="540"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" FontFamily="{StaticResource UiFont}">

    <Border Background="{StaticResource Surface0}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14"
            MouseLeftButtonDown="Root_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.65" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <Grid Grid.Row="0" Margin="28,24,18,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Width="34" Height="34" Source="Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="耗易达 · 超市播音软件" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                            <TextBlock Text="安装程序 v1.0 · 超市营销好帮手" FontSize="11"
                                       Foreground="{StaticResource TextFaint}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Style="{StaticResource Btn}" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="Close_Click" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource TextDim}" />
            </Grid>

            <!-- 主体 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="28,8,22,0">
                <StackPanel>
                    <TextBlock Text="安装位置" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,0,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Style="{StaticResource Input}" Text="C:\Haoyida" />
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="Browse_Click" />
                        <Button Grid.Column="2" Content="打开" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="OpenDir_Click" />
                    </Grid>
                    <TextBlock Text="建议使用纯英文路径（如 C:\Haoyida），避免语音模型加载异常。"
                               FontSize="11" Foreground="{StaticResource TextFaint}" Margin="0,7,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <CheckBox x:Name="DesktopChk" Content="创建桌面快捷方式" IsChecked="True" Foreground="{StaticResource TextDim}"
                                  FontSize="12.5" VerticalContentAlignment="Center" />
                        <CheckBox x:Name="LaunchChk" Content="安装完成后立即启动" IsChecked="True" Margin="24,0,0,0"
                                  Foreground="{StaticResource TextDim}" FontSize="12.5" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="10" Padding="16,13" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="安装内容" FontSize="12" Foreground="{StaticResource TextDim}" />
                            <TextBlock Text="主程序 · 内置 Python 语音环境 · Kokoro 中文 100 音色 · Piper 中文音色 · 7 首背景音乐 · 使用文档"
                                       FontSize="11.5" Foreground="{StaticResource TextFaint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="RuntimeHint" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource Ok}" Text="运行环境检测中…" />
                        </StackPanel>
                    </Border>

                    <ProgressBar x:Name="Bar" Height="4" Margin="0,20,0,0" Minimum="0" Maximum="100"
                                 Foreground="{StaticResource Accent}" Background="{StaticResource Surface3}" BorderThickness="0" />
                    <TextBlock x:Name="Status" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,8,0,0"
                               Text="准备就绪，点击「开始安装」。" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Grid Grid.Row="2" Margin="28,16,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Hint" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                           Text="开发主体：深圳市耗易达供应链管理有限公司 · 安装约需 1–3 分钟" />
                <Button Grid.Column="1" x:Name="CancelBtn" Content="取消" Style="{StaticResource Btn}" Click="Close_Click" />
                <Button Grid.Column="2" x:Name="InstallBtn" Content="开始安装" Style="{StaticResource PrimaryBtn}"
                        Margin="10,0,0,0" Click="Install_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
